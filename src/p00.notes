C 0x5d63 ...el sonido 0x28
C 0x5d68 la cosa de la sala: no si ya se cogio (bit 0 de sus marcas)
C 0x5d6e su tipo (0xB6FC)...
C 0x5d73 ...y su sitio: [b7 b6 tipo][y:5 x:3]
C 0x5d88 sin sitio, nada
C 0x5d8b los objetos (< 0x2D) que ya se tienen no salen
C 0x5d99 la 0x0C no sale con los bits 0-1 de 0xE062 + mapa
C 0x5dab el hueco 0xE740, si esta libre: el tipo...
C 0x5db4 ...la y (8 mas abajo los tipos 1-6)...
C 0x5dbd ...la x...
C 0x5dc0 ...y su casilla en 0xE744
C 0x5dc9 la cosa de la sala: fichas de 3 bytes de 0xB6FC + 2 x mapa...
C 0x5dd9 ...la de esta sala...
C 0x5ddc ...A = su tipo
C 0x5de4 Z en la sala del jefe del mapa (0x5DFB + mapa), si no esta vencido
C 0x5e11 con los bancos 13, 14 y 15: la fuente desde el caracter 1...
C 0x5e1d ...y desde el 0x0B...
C 0x5e26 ...en color 0xF0 (blanco sobre transparente)
C 0x5e34 la fuente del titulo: colores en franjas...
C 0x5e3a ...las cifras en 0x10...
C 0x5e43 ...0x9AA2 en el 0x1A, 0x9ACC en el 0x20...
C 0x5e55 ...y las letras en 0x21
C 0x5e5e en color 0xF0 desde el caracter 0x10
C 0x5eaf los dibujos de los 16 primeros a 0...
C 0x5ec1 ...y cada uno de un color, de 0 a 15
C 0x5ed0 ningun cartucho aun
C 0x5ed7 EXPTBL: los cuatro slots
C 0x5edd los expandidos se miran por subslots
C 0x5ee6 al primero que se encuentra, se acaba
C 0x5ef5 el slot con el bit de expandido...
C 0x5f05 ...y los cuatro subslots (+4)
C 0x5f0c 6 bytes en 0x7FFA del slot: Game Master...
C 0x5f1f ...6 en 0xBFFA: Q*bert...
C 0x5f32 ...o Knightmare
C 0x5f44 un byte de HL en el slot C...
C 0x5f4c ...comparado con el de DE
C 0x5f55 los B iguales: acarreo
C 0x5f79 las flechas: 3 cifras en la fila 0, columna 24
C 0x5f84 las monedas: fila 1
C 0x5f8f las llaves: fila 2
C 0x5f9a el estado 7 del personaje, al cambiar de sala, vuelve a 0
C 0x5fa8 en la sala 0x92, 9 bytes de 0x5FBA a 0xE4A1
C 0x5fc3 0xE01F = 1 o 2: su sitio (detras)
C 0x5fcc por arriba (1): aparece abajo, y = 0xB9
C 0x5fd2 por abajo (2): arriba, y = 0x28
C 0x5fe5 con el bit 0 de 0xEC12...
C 0x5feb ...la y mas lo de 0xEC18
C 0x56e7 0x50 bytes de colores a 0...
C 0x56f0 ...en cada tercio
C 0x55b5 dos casillas a 0...
C 0x55b8 ...y a la fila siguiente
C 0x55be y una fila saltada
C 0x5bdb LDIRVM...
C 0x5be1 ...y al tercio siguiente
C 0x5c14 los trozos que siguen al primero...
C 0x5c18 ...hasta un 0
C 0x5c1c y al tercio siguiente
C 0x414c DE = HL + 2 x A...
C 0x4151 ...y lo que hay ahi
C 0x415c DE = -DE: complemento...
C 0x4162 ...mas uno
C 0x5c57 n bytes tal cual al puerto del VDP
C 0x5c5d (C' es el puerto)
C 0x4140 la direccion de vuelta es la tabla: HL + 2 x A...
C 0x4147 ...y salta a lo que diga

# --- BLOQUES QUE LEE EL CODIGO (seccion que reescribe tools/bloques.py; no editar a mano) ---
D 0x4000 0x4010 cabecera_ab  la cabecera del cartucho: 'AB', INIT (0x4095) y STATEMENT, DEVICE y TEXT a cero; lo leen la BIOS (16 bytes)
F 0x4000 16
D 0x4010 0x4050 cabecera_de_konami  la cabecera de Konami que lee el Game Master desde la otra ranura: 'CD', 0x07 0x49 (RC-749) y, detras, direcciones de la RAM del juego (0xE0FE, 0xE104, 0xE1C6...); el propio cartucho no la lee; lo leen el Game Master (64 bytes)
F 0x4010 8
D 0x428E 0x42B8 tabla_428E  21 destinos del despachador de 0x4140 (call en p00:428B): 0x42B8, 0x430C, 0x433C, 0x43F0, 0x4420, 0x4462, 0x44F2, 0x454F ...; lo leen p00:428B (42 bytes)
F 0x428E 2
D 0x4340 0x4348 tabla_4340  4 destinos del despachador de 0x4140 (call en p00:433D): 0x4348, 0x437B, 0x43B4, 0x43C5; lo leen p00:433D (8 bytes)
F 0x4340 2
D 0x48C9 0x48D3 tabla_48C9  5 destinos del despachador de 0x4140 (call en p00:48C6): 0x48D3, 0x48E4, 0x4909, 0x4922, 0x493D; lo leen p00:48C6 (10 bytes)
F 0x48C9 2
D 0x49BE 0x49D0 tabla_49BE  9 destinos del despachador de 0x4140 (call en p00:49BB): 0x49D0, 0x49DA, 0x49E5, 0x49F0, 0x49F9, 0x4A1E, 0x4A35, 0x4A51 ...; lo leen p00:49BB (18 bytes)
F 0x49BE 2
D 0x4B4E 0x4B5B rle_4B4E  rle a la VRAM (0x5C46); lo leen p00:4B3F (13 bytes)
F 0x4B4E 16
D 0x543B 0x5465 tabla_543B  21 destinos del despachador de 0x4140 (call en p00:5438): 0x5487, 0x5487, 0x5465, 0x5465, 0x5487, 0x5488, 0x5465, 0x5465 ...; lo leen p00:5438 (42 bytes)
F 0x543B 2
D 0x5A1E 0x5A2C tabla_5A1E  7 destinos del despachador de 0x4140 (call en p00:5A1B): 0x5A2C, 0x5A33, 0x5A3A, 0x5A48, 0x5A5D, 0x5A72, 0x5A80; lo leen p00:5A1B (14 bytes)
F 0x5A1E 2
D 0x5FFF 0x6000 partida_5FFF  la instruccion de p00:5FFF (32 | 07 E5) empieza al final del banco 0 y acaba al principio del 1, que el cartucho pone siempre a continuacion: aqui el primer byte; lo leen p00:5FFF (1 bytes)
F 0x5FFF 4
# --- fin de los bloques de bloques.py ---

# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x4095 init el arranque del cartucho: slot, H.KEYI, RAM a cero, y a esperar la interrupcion
L 0x40D3 slot_del_cartucho A = el slot de la pagina 1 para ENASLT (con el bit 7 y el subslot si esta expandido)
L 0x40EF interrupcion H.KEYI, cada cuadro: el sonido (bancos 13 y 14) y el juego (p00:4277)
L 0x4136 hl_mas_a HL += A
L 0x413B de_mas_a DE += A
L 0x4140 despacha salta a la entrada A de la tabla de palabras que va detras del call
L 0x414C palabra_de_tabla DE = la palabra A de la tabla de HL
L 0x4155 byte_de_tabla A = el byte HL + A
L 0x415C de_negado DE = -DE
L 0x4164 hl_negado HL = -HL
L 0x416C bancos_1_2_3 pone los bancos 1, 2 y 3 (y sus copias en 0xF0F1-0xF0F3)
L 0x4185 bancos_4_5_6 pone los bancos 4, 5 y 6 (y sus copias en 0xF0F1-0xF0F3)
L 0x419E bancos_7_8_9 pone los bancos 7, 8 y 9 (y sus copias en 0xF0F1-0xF0F3)
L 0x41B7 bancos_10_11_12 pone los bancos 10, 11 y 12 (y sus copias en 0xF0F1-0xF0F3)
L 0x41D0 bancos_13_14_15 pone los bancos 13, 14 y 15 (y sus copias en 0xF0F1-0xF0F3)
L 0x41E9 p6000_banco_1 pone el banco 1 en 0x6000
L 0x41F4 p6000_banco_4 pone el banco 4 en 0x6000
L 0x41FF p8000_banco_2 pone el banco 2 en 0x8000
L 0x420A p8000_banco_14 pone el banco 14 en 0x8000
L 0x4215 a000_banco_3 pone el banco 3 en 0xA000 (y su copia en 0xF0F3)
L 0x4220 a000_banco_6 pone el banco 6 en 0xA000 (y su copia en 0xF0F3)
L 0x422B a000_banco_9 pone el banco 9 en 0xA000 (y su copia en 0xF0F3)
L 0x4236 a000_banco_12 pone el banco 12 en 0xA000 (y su copia en 0xF0F3)
L 0x4241 a000_banco_15 pone el banco 15 en 0xA000 (y su copia en 0xF0F3)
L 0x4277 juego_del_cuadro sube 0xE003 y despacha por el estado 0xE000 (tabla 0x428E)
L 0x42F1 prepara_el_titulo pantalla, sprites y graficos del titulo (p01:6215)
L 0x4335 pon_e698 0xE698 = 1
L 0x435E paso_siguiente sube el paso 0xE001
L 0x43A2 estado_a el estado A con el paso 0
L 0x43A9 al_estado al estado A con el paso 0 y 0x20 cuadros de espera
L 0x43CB vuelta_de_e023 0xE023 de 0 a 1 y vuelta
L 0x43D8 calla_o_vuelve da la vuelta al bit 0 de 0xE00D: calla o vuelve la musica
L 0x4439 estado_siguiente al estado siguiente con el paso 0 y 0x20 cuadros de espera
L 0x4443 paso_a el paso A
L 0x44EA personaje_4_a_7 C si el estado del personaje es 4-7
L 0x4538 pinta_vidas la lista de 0x7CF6 o 0x7D06 segun quien juega
L 0x4579 hay_jefe NZ si hay jefe en la sala (0xE0D2 o 0xE0D4)
L 0x4614 mapa_del_mundo mapa = 0xE688 + 1, sala 1
L 0x461F objetos_del_mundo pone los objetos 0x07-0x0A segun los bits 7-4 de 0xE061 + mapa
L 0x4646 borra_lo_del_mapa dos bytes de la tabla 0x4689 y el tramo de RAM del mapa (0xAF09/0xAF20, banco 9) a cero
L 0x465A borra_tramo_del_mapa el tramo de RAM del mapa (0xAF09/0xAF20, banco 9) a cero
L 0x469F vacia_figuras los huecos de figura 0xE800-0xE9FF a cero
L 0x472A lista_7d1d pinta la lista de 0x7D1D
L 0x4730 sin_objetos_del_mundo los objetos 0x07-0x0A a cero
L 0x4792 vecina_del_lado A = la vecina 0xE647 + 0xE01A
L 0x479C pozo_del_mapa_4 en el mapa 4, subir cinco veces seguidas por arriba de la sala 4 pone 0xE0A1
L 0x4901 graficos_de_la_sala_especial sus graficos y la musica 0x8D
L 0x49B0 sala_sin_salidas las cuatro vecinas 0xE648-0xE64B a 0xFF
L 0x4BA9 cosa_del_jefe_vencido pone la cosa 0x0C en el sitio de la tabla 0x4BCD del mapa (0xE0D4 = 1)
L 0x4BFA tecla_en_el_titulo espacio o M en el titulo empieza; en los estados 1 y 2 vuelve al 0
L 0x4C3D vram_a_cero el sonido desde cero, la VRAM a 0 y los registros del VDP
L 0x4C4A registros_del_vdp los registros 0-7 del VDP de la tabla 0x4C5B
L 0x4C63 color_de_fondo el registro 7 del VDP = B
L 0x4C68 lee_el_mando el mando en 0xE009 (apretado) y 0xE008 (recien apretado)
L 0x4C6E guarda_el_mando A en (HL) y lo recien apretado en (HL - 1)
L 0x4C75 mando A = joystick 1 y teclado: arriba, abajo, izquierda, derecha, A/espacio, B/M
L 0x4CB0 partida_nueva RAM a cero, sala 1 del castillo, Popolon y las vidas de 0x4CE6
L 0x4CF1 regalo_de_cartucho lo que dan Q*bert (bit 1) y Knightmare (bit 0) de 0xF0F8 al empezar
L 0x4D1E cortinilla baja la espera y borra una columna; P mientras quede
L 0x4D38 sin_sprites 0xD0 en la tabla de sprites: no se ve ninguno
L 0x4D47 borra_la_sala sin sprites y las filas 4-23 de la pantalla a 0
L 0x4D5A suma_flechas suma A (BCD) a las flechas de 0xE046, hasta 999
L 0x4D7B suma_monedas suma A (BCD) a las monedas de 0xE048, hasta 999
L 0x4D82 suma_llaves suma A (BCD) a las llaves de 0xE04A, hasta 999
L 0x4D89 cifras_bcd pinta B bytes BCD de DE hacia atras en la VRAM de HL
L 0x4D95 cifra_baja pinta la cifra baja de (DE) y sigue con cifras_bcd
L 0x4DA1 casilla_de_yx HL = la casilla de la copia de nombres de 0xED00 en la y (L) y la x (H)
L 0x4DB5 bajo_la_figura C si el caracter de debajo de la figura IX o su derecha pasa de 0xB9
L 0x4DC5 casilla_derecha compara 0xB9 con el caracter de HL + 1
L 0x4DC8 casilla_b9 C si el caracter de la casilla de HL pasa de 0xB9
L 0x4DCF multiplica HL = H x E
L 0x4DDB tiene_o_popolon NZ si la marca de HL esta puesta o se lleva a Popolon (0xE501)
L 0x4DE3 azar A = R con el contador de cuadros
L 0x4DED sonido_a_cero el estado del sonido a cero y los canales callados
L 0x4E02 calla los programas de canal al vacio de 0x6075
L 0x4E1F pide_sonido pide el sonido A al banco 13 (p00:4E6B con los bancos 13 y 14)
L 0x4E34 pide_sonido_ya como pide_sonido, sin mirar la pausa
L 0x4E6B sonido 0 calla, 0x01-0x7F efecto, 0x80-0xF9 musica (tabla 0x743E), 0xFA-0xFF p00:4F52
L 0x4F12 efecto el efecto A si no suena uno mayor (tabla 0x73DC, canal 0xE15D)
L 0x4F52 sonido_especial 0xFA/0xFF se apaga, 0xFB/0xFC, 0xFD/0xFE la pausa
L 0x4F87 pausa_del_sonido 0xFD: guarda la musica y el PSG y calla
L 0x5014 fin_de_la_pausa_del_sonido 0xFE: la musica y el PSG como estaban
L 0x50F5 suena NZ mientras suena algo
L 0x510B monta_la_sala la sala entera con todo lo que lleva
L 0x5129 monta_lo_de_la_sala lo que va encima de la sala: figuras, cosas, puertas, escaleras, rotulo
L 0x51A6 rotulo_del_mapa el rotulo de arriba (castillo o WORLD) y el numero del mundo
L 0x51CD monta_otra_sala la sala al pasar a otra
L 0x51DF monta_la_sala_sola la sala, sin sprites
L 0x51E8 monta_la_sala_otra_vez la sala y lo de encima
L 0x51F7 jefe_otra_vez si hay jefe, 0xE0D2 = 1
L 0x5200 cosa_del_jefe_otra_vez si estaba puesta, la cosa del jefe vencido
L 0x520B sonido_fc con 0xE0D5, una vez, el sonido 0xFC
L 0x5218 vecinas_de_la_sala las vecinas de la sala (tabla 0xA9EF, banco 9) a 0xE648; con jefe, ninguna
L 0x523E marcas_de_la_sala 0xE60C y 0xE60E: los bytes de la sala en el tramo del mapa (0xAF09)
L 0x525E borra_e600 0xE600-0xF03F a cero
L 0x526C borra_e540 0xE51C, 0xE51D y 0xE540-0xE5FF a cero
L 0x5280 esconde_sprites la copia de la tabla de sprites (0xEC80) con y = 0xE0
L 0x528E entra_el_personaje el personaje al entrar: estado a cero y el sitio de la tabla 0xB106
L 0x52F5 cuadro_de_partida un cuadro de la partida: todas las rutinas de cada banco
L 0x5423 fin_del_cuadro p15:BD06 y p15:BDA1 con las figuras quietas
L 0x5435 vram_del_estado lo de la VRAM en la interrupcion segun el estado (tabla 0x543B)
L 0x5474 sprites_a_vram la copia de la tabla de sprites (0xEC80) a 0x3B00
L 0x5488 sprites_turnados la tabla de sprites a la VRAM empezando cada cuadro por otro
L 0x54BF sala_a_vram la pantalla de la sala (0xED80) a las filas 4-23
L 0x54DD figuras_quietas 0xE602 = 1: no se tocan los sprites
L 0x54E1 figuras_sueltas 0xE602 = 0
L 0x54E6 pantalla_a_cero la copia de la tabla de nombres a cero y a la VRAM
L 0x54F3 nombres_a_vram la copia de la tabla de nombres (0xED00) a 0x3800
L 0x54F6 nombres_a_vram_bc BC bytes de 0xED00 a 0x3800
L 0x54FF pared_en_fila C si una de las casillas (y+B, x+D) o (y+B, x+E) llega al umbral de 0xF020
L 0x551F pared_en_columna C si una de las casillas (x+B) o (y+D) llega al umbral de 0xF020
L 0x553E pared_en C si la casilla (y+E) llega al umbral de 0xF020
L 0x554D umbral_de_pared 0xF020 = 0xBA, o 0xF0 con jefe
L 0x5561 monta_la_planta la planta y lo que la cambia (objeto 0x18, mapa 4); no en salas especiales
L 0x5575 fila_f0_del_mapa_9 con el objeto 0x18 y 0xE619, en el mapa 9 las filas 16-23 a 0xF0
L 0x5590 sala_del_jefe_del_mapa_4 en el mapa 4 con jefe, las paredes de los lados vacias
L 0x55B0 vacia_columna 5 x 3 filas de 2 casillas a 0
L 0x55C6 planta_y_recuadro la planta y, con 0xE615, el recuadro del jefe (0x9BE2)
L 0x55F7 planta los 40 bloques de la sala (tabla 0x6ABE) en la copia de nombres
L 0x5649 bloque un bloque de 4 x 4 caracteres (0x6000 + 16 x bloque)
L 0x568E graficos_de_la_sala la carga grafica de la sala (tools/vram.py carga_sala)
L 0x56B8 acaba_graficos las filas 0-3 a cero, figuras sueltas y bancos 1-2-3
L 0x56C1 empieza_graficos bancos 10-11-12 y figuras quietas
L 0x56C7 borra_cabecera las filas 0-3 de la copia de nombres a cero
L 0x56D5 caracteres_del_jefe_en_blanco con jefe, los colores de 0x9C-0xA5 a 0
L 0x56FA graficos_de_la_sala_del_jefe en la sala del jefe, sin jefe, los graficos de 0x6121
L 0x5711 graficos_del_estado_0b los graficos del estado 0x0B (el objeto de 0xE097 en el caracter 0xF1)
L 0x571C graficos_del_inventario los caracteres de 0x6EDA/0x6F91 y el objeto de 0xE097
L 0x5755 sprites_1d00 el rle de 0x7831 a 0x1D00
L 0x575E graficos_del_estado_0c los graficos del estado 0x0C
L 0x5772 graficos_del_titulo los graficos del titulo
L 0x579A graficos_del_final los graficos del final
L 0x57C4 reescribe_2510 0xA0 bytes de 0x2510 y 0x0510 en los tres tercios
L 0x57CD reescribe_tercios 0xA0 bytes de HL a 0xE800 y de vuelta a los tres tercios
L 0x57E1 graficos_de_sala_especial los graficos de la sala especial y lo que vende
L 0x5832 dibujos_de_hundirse los dibujos de sprite de hundirse (0x7B34 en 0x1900)
L 0x5848 graficos_del_jefe_si_hay con jefe, sus graficos
L 0x5856 graficos_del_jefe los graficos del jefe 0xE0D3 (fichas 0x6157, copias 0x6202; el 2 por pasos)
L 0x587B un_paso_del_jefe_2 un paso de los graficos del jefe 2
L 0x5884 paso_del_jefe_2 el paso 0xE61B: fichas 0x6175 (1-7) o copias 0x621A (8-0x2B)
L 0x58D3 dibujo_de_la_cosa_0c el dibujo de la cosa 0x0C en 0x23B0
L 0x58DE dibujo_de_la_cosa el dibujo de la cosa A en el caracter 0x76
L 0x58E1 dibujo_de_cosa carga el dibujo y los colores de la cosa A (0x6E34/0x6E80) en HL
L 0x590E sprites_del_personaje los dibujos de sprite del personaje
L 0x5917 sprites_de_la_taza la taza de la pausa: 0xBF16 (banco 15) a 0x1800
L 0x592F sprites_de_la_sala los dibujos de sprite de la sala (tools/sprites.py)
L 0x5937 sprites_base el rle de 0x790B y las vueltas de 0x7907
L 0x5944 sprites_1e20 los rle de 0x7849 y 0x7BB2 a 0x1E20 y 0x1F20
L 0x594D sprites_1f20 el rle de 0x7BB2 a 0x1F20
L 0x5956 sprites_1f20_solos el rle de 0x7BB2 a 0x1F20 con las figuras quietas
L 0x595F juegos_de_la_sala los juegos de sprites de la lista 0x9737 de la sala
L 0x5989 juego_de_sprites el juego A (ficha 0x7C72): dibujos y vueltas
L 0x59A6 dibujos_de_juego [dibujo][rle] hasta 0: cada rle a 0x1800 + 8 x dibujo
L 0x59BF vueltas_de_sprites [de][a][cuantos] hasta 0xFF: dibujos de sprite del reves
L 0x59E9 graficos_del_mapa las fichas comunes y las del castillo por zona (0x60D7) o de los mundos
L 0x5A33 fichas_6076 las fichas de 0x6076
L 0x5A87 copias_de_tabla las copias del elemento A de la tabla HL
L 0x5A8D copias_volteadas copia caracteres dandoles la vuelta, fichas de 4 bytes desde IX
L 0x5AAD fichas_de_tabla las fichas del elemento A de la tabla HL
L 0x5AB3 fichas_graficas dibujos y colores por rle, fichas de 6 bytes desde IX
L 0x5ADA ficha_en_tercio los dibujos y colores de una ficha en el tercio DE
L 0x5B08 vuelta_a_bytes da la vuelta a los bits de los bytes de 0xED00
L 0x5B1E copia_a_tercios los dibujos y colores de 0xED00/0xED40 a los tercios de la ficha
L 0x5B3A copia_a_un_tercio los dibujos y colores de 0xED00/0xED40 al tercio DE
L 0x5B66 lee_caracteres los dibujos y colores del caracter de origen a 0xED00/0xED40
L 0x5BB5 pantalla_negra la tabla de nombres a 0, sin sprites
L 0x5BC8 vram_para_escribir SETWRT de HL y C' = el puerto de datos del VDP
L 0x5BD4 ldirvm LDIRVM de DE a HL
L 0x5BD8 ldirvm_tres_tercios LDIRVM en los tres tercios
L 0x5BEB filvrm_tres_tercios FILVRM en los tres tercios
L 0x5BFC rle_tres_tercios el rle de DE en HL y en los otros dos tercios (+0x800)
L 0x5C0C rle_tres_tercios_trozos el rle con sus trozos en los tres tercios
L 0x5C25 lista_a_vram pinta la lista de DE: [destino] y bytes, 0xFE otro destino, 0xFF acaba
L 0x5C3C borra_lista_vram como lista_a_vram pero escribiendo ceros
L 0x5C40 rle_con_destino el rle de la direccion que hay en DE
L 0x5C46 rle_a_vram descomprime el rle de DE en la VRAM de HL
L 0x5C49 rle_sigue el rle desde DE con la VRAM ya puesta
L 0x5C6B sprites_del_reves C sprites de 16 x 16 del reves
L 0x5C77 sprite_del_reves un sprite de 16 x 16 del reves
L 0x5C93 bits_del_reves A con los bits del reves
L 0x5C9E musica_que_espera pide la musica de 0xE01E cuando acaba lo que suena
L 0x5CAF musica la musica A (0xE021 = 1 salvo 0x87-0x8B)
L 0x5CC4 musica_ya sin musica esperando, la musica A
L 0x5CC9 sin_musica_esperando 0xE01D-0xE01E a cero
L 0x5CD0 musica_de_la_sala la musica de la sala (jefe 0x90, jefe vencido 0x91, 0x8F)
L 0x5CE0 musica_del_jefe C con jefe (0x90) o con la cosa del jefe vencido (0x91)
L 0x5CF6 musica_del_mapa_si la musica del mapa si espera la 0x8F o con 0xE021
L 0x5D0A musica_despues apaga lo que suena y deja esperando la musica A
L 0x5D12 musica_espera deja esperando la musica A
L 0x5D1A musica_del_mapa A = 0x88 en el castillo, 0x8A en los mundos
L 0x5D24 pista_del_objeto_14 con el objeto 0x14, el sonido 0x28 en las salas de la lista del castillo
L 0x5D37 salas_del_objeto_14 la lista de salas del ultimo mundo con el bit 1
L 0x5D68 cosa_de_la_sala pone la cosa de la sala en el hueco 0xE740 si no se ha cogido
L 0x5D88 pon_cosa la cosa C en la y D, x E (hueco 0xE740)
L 0x5DC9 tipo_de_cosa A = el tipo de la cosa de la sala (0xB6FC), Z sin cosa
L 0x5DE4 sala_del_jefe Z en la sala del jefe del mapa sin vencer
L 0x5E11 fuente la fuente (0x9AD3, 0x9B24) y los caracteres 1-0x24 en color 0xF0
L 0x5E34 fuente_del_titulo la fuente del titulo y los colores de los primeros caracteres
L 0x5E6C caracteres_2160 el rle de 0x9AA2 en 0x2160
L 0x5E7B caracteres_2168 el rle de 0x9ABD en 0x2168 en color 0xF0
L 0x5E95 caracteres_25d0 el rle de 0x9BEC en 0x25D0 en color 0xF0
L 0x5EAF colores_en_franjas los 16 primeros caracteres con colores 0-15
L 0x5ED0 mira_las_ranuras busca en todos los slots y subslots las firmas de busca_cartuchos
L 0x5EF5 mira_subslots busca_cartuchos en los cuatro subslots del slot C
L 0x5F0C busca_cartuchos mira la firma de Game Master, Q*bert y Knightmare en la otra ranura (0xF0F8)
L 0x5F44 compara_en_slot C si los B bytes de HL en el slot C son los de DE
L 0x5F79 pinta_flechas las flechas en la fila 0, columna 24
L 0x5F84 pinta_monedas las monedas en la fila 1, columna 24
L 0x5F8F pinta_llaves las llaves en la fila 2, columna 24
L 0x5F9A fin_del_estado_7 el estado 7 del personaje vuelve a 0
L 0x5FA8 sala_92 en la sala 0x92, 9 bytes de 0x5FBA a 0xE4A1
L 0x5FC3 sitio_al_entrar el sitio del personaje segun el lado por el que sale
C 0x4050 despacha: salta a la entrada A de la tabla de palabras que va detras del call
C 0x4053 palabra_de_tabla: DE = la palabra A de la tabla de HL
C 0x4056 casilla_de_yx: HL = la casilla de la copia de nombres de 0xED00 en la y (L) y la x (H)
C 0x4059 pide_sonido: pide el sonido A al banco 13 (p00:4E6B con los bancos 13 y 14)
C 0x405C hl_negado: HL = -HL
