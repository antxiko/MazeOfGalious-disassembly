L 0x94FA mensaje_a pinta el mensaje A ya con su idioma
L 0x9505 mensaje_sin_idioma pinta el mensaje A de la tabla 0xB09E
L 0x952B el_que_atiende el nombre y el dibujo de quien atiende la sala especial (tabla 0x954C)
L 0x9561 cursor_de_articulo el cursor 0x6E sobre el articulo elegido
