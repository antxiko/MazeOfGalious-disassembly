L 0x86F8 paso_0_del_jefe el paso del jefe a 0
L 0x871A quieto_en_y velocidad vertical 0
L 0x8720 lengua_jefe_7 cada 0x10 cuadros saca la lengua (figura 0x65)
L 0x8765 muerde_jefe_7 el jefe 7 muerde
L 0x8775 quita_bit_4 quita el bit 4 de las banderas
L 0x877A jefe_de_lado 8 pasos de lado
