L 0x962C contrasena_en_grupos la contraseña en grupos de 4 con saltos de linea
L 0x9653 objetos_del_nivel con el nivel 2 o 3 de 0xE097, el objeto 0x2B o 0x2C
L 0x9664 letra_de_contrasena A = la letra de la tabla 0x9671 para el valor A en la posicion B
L 0x9695 suma_de_contrasena L = la suma de los 43 caracteres
L 0x96A3 vidas_en_bits A = las vidas, 0xE05A/0xE05B y quien juega en bits
L 0x96C4 empaqueta_bits A valores de DE en grupos de 5 bits a HL
L 0x9704 contrasena_a_cero 0xE02B a 0 y el tampon a cero
L 0x9708 tampon_a_cero 0xEB00-0xEBFF a cero
L 0x9716 teclea_contrasena un cuadro de la pantalla de teclear la contraseña (estado 0x12)
L 0x9722 tecla_de_contrasena la tecla recien apretada a la contraseña; RETURN acaba
L 0x9757 cursor_de_contrasena el cursor con izquierda y derecha (0-0x2C)
L 0x976F sprite_del_cursor el sprite del cursor en su sitio
L 0x97AF pinta_contrasena la contraseña tecleada en tres filas
L 0x97C7 fila_de_contrasena 16 letras en grupos de 4
