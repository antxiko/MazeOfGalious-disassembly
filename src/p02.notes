L 0x87B0 tope_y_jefe_7 C al llegar arriba o abajo
L 0x87C3 tope_x_paso un paso mas y C al llegar a un lado
L 0x87C6 tope_x_jefe C al llegar a la izquierda o a la derecha
L 0x87D9 jefe_vertical velocidad 0x100 arriba o abajo
L 0x87E6 sale_jefe_11 el jefe 11 sale (x 0x80, y 0x70, mosaico 43)
L 0x8815 jefe_11 el jefe 11 (mundo 4): se arrastra, se encoge y salta
L 0x8945 mosaico_jefe_11 cada 8 cuadros, mosaico 43 o 44
L 0x895C sale_jefe_6 el jefe 6 sale (y 0x70, x 0x58) y las cuatro figuras 0x69
L 0x89A0 jefe_6 el jefe 6 (mundo 9): cambia de cabezas y escupe fuego
L 0x89F5 cabezas_jefe_6 otras cabezas al azar (tabla 0x8A1E)
L 0x8A22 fuego_jefe_6 cada 0x10 cuadros dos llamaradas desde una boca (tabla 0x8A6E)
L 0x8A7A sale_jefe_8 el jefe 8 sale (y 0x20, x 0x68, mosaico 40)
L 0x8AA4 jefe_8 el jefe 8 (mundo 8): va de lado y de arriba abajo hacia el personaje
L 0x8ACD mosaico_bit_0 el mosaico del jefe cambia el bit 0
L 0x8C00 jefe_8_herido el jefe 8 herido escupe figuras 0x68
L 0x8C57 jefe_a_la_derecha velocidad de lado 0x80 a la derecha
L 0x8C60 jefe_a_la_izquierda velocidad de lado 0x80 a la izquierda
L 0x8C69 jefe_baja velocidad vertical 4
L 0x8C72 jefe_sube velocidad vertical -2
L 0x8C7B mosaicos_cada_4 cada 4 cuadros los mosaicos se alternan
L 0x8C8C jefe_8_vida si baja la vida, el jefe 8 queda herido
L 0x8CBB jefe_8_estrecho y + 8, x - 8
L 0x8CCC jefe_8_ancho y - 8, x + 8
L 0x8CDD sale_jefe_9 GALIOUS sale (y 0x40, x 0x60) con ocho figuras 0x67
L 0x8D24 banderas_e0 banderas 0xE0
L 0x8D2D jefe_9 el jefe 9 (mundo 10, GALIOUS): lanza, desaparece y reaparece
L 0x8D82 banderas_a_cero las banderas altas a 0: no se ve
L 0x8E3E lanza_jefe_9 las cuatro figuras desde (ix+0x25)
L 0x8E63 quita_marca el byte 0x1F de la figura a 0
L 0x8E6D quedan_figuras Z si no queda ninguna de las 8 primeras figuras
L 0x8E82 cuenta_jefe_9 cuenta (ix+0x34); NZ si dispara
L 0x8E97 mira_jefe_9 si el personaje esta cerca de su sitio de disparo
L 0x8EEF sala_especial la sala especial del mapa (0x8F0A): pista o tienda
L 0x8F1E entra_en_sala_especial todo a cero y la pantalla de la sala especial
L 0x8F43 cuadro_de_sala_especial cada cuadro, por el tipo de sala especial (tabla 0x8F4A)
L 0x8F72 revivir tipo 3: revivir al otro por 100 monedas, 100 flechas y 20 llaves
L 0x8FCE llega_para_revivir acarreo si no hay 20 llaves, 100 monedas y 100 flechas
L 0x90C0 contrasena tipo 1: la contraseña
L 0x9126 tienda las tiendas: por el paso 0xE691
L 0x9142 precios los tres precios de la tienda en pantalla
L 0x915A precio un precio BCD en dos cifras
L 0x916F cursor_al_primero el cursor en el primer articulo que queda
L 0x91E5 paso_de_sala_especial sube el paso 0xE691
L 0x922B paga resta BC (BCD) de las monedas de 0xE048 y las repinta
L 0x9234 resta_bcd (HL) -= BC en BCD
L 0x923E articulo_de_tienda C = precio y D = objeto del articulo 0xE692 de la tienda 0xE690
L 0x92BD articulo_comprado marca el articulo y borra su dibujo
L 0x92E8 pista las salas de pista: su mensaje (tabla 0x9308)
L 0x930F cursor_de_tienda el cursor con izquierda y derecha
L 0x931B cursor_izquierda el articulo anterior que quede
L 0x933E cursor_al_2 el articulo 2
L 0x9351 cursor_derecha el articulo siguiente que quede
L 0x9377 cursor_al_0 el articulo 0
L 0x937A borra_mensajes 5 filas de 20 desde 0xEE26 a cero
L 0x937C borra_filas C filas de 20 desde 0xEE26 a cero
L 0x938E sprites_de_sala_especial el personaje, el cursor y el que atiende
L 0x93A3 personaje_en_la_puerta el personaje en y 0xAF, x 0x80
L 0x93AE pantalla_de_sala_especial paredes, techo, suelo, puerta y recuadros
L 0x9446 linea_6c 22 caracteres 0x6C
L 0x9451 columna_6d una columna de 10 caracteres 0x6D
L 0x9454 columna_de_c B veces C en columna
L 0x945C articulos los dibujos de los tres articulos de la tienda
L 0x947D articulo el dibujo de un articulo
L 0x94E1 dos_por_dos_a 2 x 2 caracteres seguidos desde A en HL
