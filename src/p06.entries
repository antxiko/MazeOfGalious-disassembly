0xA1C4   # p06:A1BB entrada 0 de la tabla de 0xA1BE (call 0x4140 en 0xA1BB)
0xA1F8   # a mano, codigo huerfano: ld (ix+0x17),0 / ret detras de un `jp`; ninguna palabra de los bancos 4-6 vale 0xA1F8
