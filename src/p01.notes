C 0x7161 [x]...
C 0x7163 ...[0xC8]...
C 0x7167 ...[8]
C 0x716d [x + 16]...
C 0x7176 ...[8]
C 0x7194 la x tambien a (ix+0x13)
C 0x71a5 el ultimo: se acabo
C 0x71ae el dibujo - 0xA0...
C 0x71b1 ...entre 4: una de 8 formas
C 0x71b8 lo que sobra por la derecha
C 0x71ba el dibujo siguiente
C 0x71c8 lo que sobra por la izquierda
C 0x71cd x + derecha - izquierda
C 0x71d0 HL vuelve a los sprites
C 0x71d5 y el siguiente
C 0x7084 B: lo que se mueve
C 0x708b x 2...
C 0x708f ...en 0x70BE
C 0x7096 - 1
C 0x7097 la x
C 0x709d [x]
C 0x70ab [y + 3]
C 0x70b0 x + lo de 0xF005
C 0x70ba [color 11]
C 0x664e el ancho...
C 0x6654 ...los caracteres de la fila...
C 0x6659 ...y sigue la tabla
C 0x665f la fila siguiente de la pantalla
C 0x6666 cuantas filas
C 0x6676 la sala...
C 0x667c ...su byte en la tabla
C 0x6686 el sitio, en 0xF020
C 0x6689 en el castillo nada mas
C 0x669d el sitio de la marca 2
C 0x66a3 color 5
C 0x76a1 HL al byte 5 de la ficha
C 0x76a6 C = la y
C 0x76a8 HL al byte 7
C 0x76ae B = x + 16
C 0x76bb [x + 16]
C 0x76bd [0xE4]
C 0x76c0 [15]
C 0x787c HL = la ficha + 2...
C 0x7883 ...la y...
C 0x7886 ...la x
C 0x788e la casilla en los bytes 6-7
C 0x7899 el dibujo (byte 4)
C 0x78a0 ancho y alto a (ix+8) y (ix+9)

