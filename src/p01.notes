F 0x70BE 2
D 0x71D9 0x71DE cinco_bytes_71d9  5 bytes que p01:71AB elige con ((DE) - 0xA0) / 4
D 0x71DE 0x71E3 cinco_bytes_71de  5 bytes que p01:71BB elige igual con el byte siguiente
D 0x73AF 0x73B3 bloque_73af  2 x 2 caracteres que p01:7396 copia (dos y dos, una fila mas abajo)
D 0x73B3 0x73B7 bloque_73b3  2 x 2 caracteres que p01:739C copia igual cuando A no es 0
D 0x73D2 0x73D6 bloque_73d2  2 x 2 caracteres que p01:73C0 copia a (0xE684)
