# --- ANOTACIONES AUTOMATICAS (seccion que reescribe tools/anota.py; no editar a mano) ---
L 0x6003 sitio_de_partida la y y la x de partida del mapa (tabla 0x6017)
L 0x6015 sitio_guardado la y y la x de 0xE0D0
L 0x602F borra_al_entrar 0xE690, 0xE603, 0xE536, 0xE539, 0xE520 y 0xE620-0xE63F a cero
L 0x604D cabecera los rotulos, flechas, monedas, llaves, arma y las cuatro barras
